FROM python:3.13-slim
WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY api ./api
COPY ml ./ml
# Only the CSVs the API reads at startup (SHAP background samples).
COPY data/raw/esol.csv data/raw/bbbp.csv data/raw/tox21.csv ./data/raw/

EXPOSE 8000
# Startup builds 14 SHAP explainers (~20s); the start period keeps that from counting as failure.
HEALTHCHECK --interval=10s --timeout=5s --start-period=90s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/openapi.json')"
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
